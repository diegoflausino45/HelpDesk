# Copie este arquivo para backend/.env e preencha os valores.
# Os valores abaixo são apenas exemplos — não use em produção.

# String de conexão do PostgreSQL (usada pela API, pelo seed e pelo Prisma CLI).
# Rodando a API dentro do Docker com o banco na sua máquina, troque "localhost"
# por "host.docker.internal".
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public"

# Segredo usado para assinar os tokens JWT. Obrigatório: a API não inicia sem ele.
# Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Porta HTTP da API (opcional, padrão 3000)
PORT=3000
